# GitHub Actions runner container image (Ubuntu 26.04, Resolute Raccoon).
#
# Built and signed by the runner-image GitHub Actions workflow; the
# github-runner NixOS module pulls the signed image and owns the run flags. The
# runner works from a host-visible root directory so sibling containers started
# by jobs (service containers, `docker run` steps, job containers, e2e distro
# stacks) can bind mount workspace paths.
#
# Pinning: the base image is the project's Quay mirror, pinned by digest, and
# apt installs from the dated Ubuntu snapshot below, so a rebuild reproduces
# the same package versions instead of tracking the live archive. Bump the
# digest and the snapshot together; the versions the snapshot resolves are
# listed beside the package set for review.
#
# The runner, docker CLI and gh tarballs are verified against the SHA-256
# digests below before they are used. Renovate (renovate.json5) tracks the base
# digest and the three *_VERSION args; bump the matching *_SHA256 in the same
# change.
FROM quay.io/peasant-labs/ubuntu:26.04@sha256:ac877d2d205a92e3483908326e088d324bdc9d4a249bbc3f261a86b0c0926ce4

ENV DEBIAN_FRONTEND=noninteractive DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=0
ARG RUNNER_VERSION=2.338.2
ARG RUNNER_SHA256=70920811a4f8ad4328818682bca5c6469c1c942fab52448868071d0063816613
ARG DOCKER_VERSION=29.10.0
ARG DOCKER_SHA256=d8db66739d2e28d4933786d73e918d9be643a67fbd835db1bf740d650a259e70
ARG GH_VERSION=2.105.0
ARG GH_SHA256=79e7ab5db738c48777b696e374f8b428f0647debfb424f44d2f426370407fe2f
ARG UBUNTU_SNAPSHOT=20260917T000000Z

# The base image ships no CA store, so the first update bootstraps
# ca-certificates from the default plain-HTTP archive sources (APT still
# verifies the Release signatures), then every source is frozen to the dated
# snapshot and the real install pins the snapshot's exact versions.
# check-valid-until stays off because a pinned snapshot is intentionally older
# than the archive's moving validity window.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot \
  && sed -i -E \
       -e "s|https?://archive\.ubuntu\.com/ubuntu|https://snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}|g" \
       -e "s|https?://security\.ubuntu\.com/ubuntu|https://snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}|g" \
       /etc/apt/sources.list.d/ubuntu.sources \
  && apt-get update \
  && apt-get install -y --no-install-recommends --allow-downgrades \
       ca-certificates=20260601~26.04.1 \
       curl=8.18.0-1ubuntu2.5 \
       file=1:5.46-5build2 \
       git=1:2.53.0-1ubuntu1 \
       jq=1.8.1-4ubuntu2 \
       build-essential=12.12ubuntu2.26.04.2 \
       libicu78=78.2-2ubuntu1 \
       podman=5.7.0+ds2-3build1 \
       sudo=1.9.17p2-1ubuntu3 \
       unzip=6.0-29ubuntu1 \
  && rm -rf /var/lib/apt/lists/*

RUN useradd -m runner \
  && echo "runner ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

# Static docker CLI: the runner shells out to `docker` for service containers,
# `docker run` steps, and job containers. Against the mounted host podman
# socket it must be the real docker client, not a podman symlink (nested
# podman cannot set up its inner userns).
RUN curl -fsSL -o /tmp/docker.tgz \
      "https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_VERSION}.tgz" \
  && echo "${DOCKER_SHA256}  /tmp/docker.tgz" | sha256sum -c - \
  && tar -xzf /tmp/docker.tgz -C /tmp docker/docker \
  && install -m 0755 /tmp/docker/docker /usr/local/bin/docker \
  && rm -rf /tmp/docker.tgz /tmp/docker \
  && docker --version

# GitHub CLI from the upstream release, not apt: the archive's gh lags far
# behind, and workflows read `--json` fields it does not know (2.46 rejects
# baseRefOid; isImmutable needs 2.76). GH_SHA256 is the linux_amd64 tarball's
# line in the release's gh_<version>_checksums.txt. linux_amd64 only, matching
# the pool (x64 slots).
#
# The require_json lists cover every `--json` field requested by workflows in
# each repository that runs on this pool: infra, schema, peasant, village,
# fairtrade and redact. The `release view` and `release list` fields are the
# release-publish reads in schema's and peasant's release.yml; keep them until
# those workflows move to `release-intent publish-release`. A pin that drops a
# field fails the build instead of a job; `gh <cmd> --json` with no value
# prints the supported fields offline. To find new fields, run in each repo:
#   grep -rhoE 'gh (pr|release) (view|list)[^|]*--json [A-Za-z,]+' .github/workflows
# Add a field when a workflow starts reading it; remove one only when that
# grep finds it in no repository's workflows.
RUN set -eu; \
  curl -fsSL -o /tmp/gh.tgz \
    "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz"; \
  echo "${GH_SHA256}  /tmp/gh.tgz" | sha256sum -c -; \
  tar -xzf /tmp/gh.tgz -C /tmp "gh_${GH_VERSION}_linux_amd64/bin/gh"; \
  install -m 0755 "/tmp/gh_${GH_VERSION}_linux_amd64/bin/gh" /usr/local/bin/gh; \
  rm -rf /tmp/gh.tgz "/tmp/gh_${GH_VERSION}_linux_amd64"; \
  gh --version; \
  require_json() { \
    cmd="$1"; shift; \
    fields="$(gh $cmd --json 2>&1 || true)"; \
    for f in "$@"; do \
      printf '%s\n' "$fields" | grep -qxE "[[:space:]]*$f" || { \
        echo "gh ${GH_VERSION}: 'gh $cmd --json' lacks field $f; gh printed:" >&2; \
        printf '%s\n' "$fields" >&2; \
        exit 1; \
      }; \
    done; \
  }; \
  require_json 'pr view' number title author headRefName headRefOid baseRefOid autoMergeRequest; \
  require_json 'pr list' number title autoMergeRequest; \
  require_json 'release view' isDraft isImmutable assets; \
  require_json 'release list' tagName isDraft

WORKDIR /home/runner

RUN curl -fsSL -o runner.tar.gz \
      "https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz" \
  && echo "${RUNNER_SHA256}  runner.tar.gz" | sha256sum -c - \
  && tar xzf runner.tar.gz \
  && rm runner.tar.gz \
  && ./bin/installdependencies.sh \
  && chown -R runner:runner /home/runner

COPY entrypoint.sh /usr/local/bin/github-runner-entrypoint
RUN chmod 0755 /usr/local/bin/github-runner-entrypoint

USER runner

ENTRYPOINT ["/usr/local/bin/github-runner-entrypoint"]
