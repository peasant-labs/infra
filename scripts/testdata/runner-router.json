  "expected_mutation_names": [
    "capacity-off-by-one",
    "freshness-check-dropped",
    "labels-length-check-dropped",
    "missing-max-capacity-treated-as-full",
    "required-slots-default-zero",
    "required-slots-validation-dropped"
  ],
  "fallback": "[\"ubuntu-24.04\"]",
  "mutations": [
    {
      "name": "capacity-off-by-one",
      "new": "> $required",
      "old": ">= $required",
      "target": "script"
    },
    {
      "name": "required-slots-default-zero",
      "new": "default: 0",
      "old": "default: 1",
      "target": "workflow"
    },
    {
      "name": "missing-max-capacity-treated-as-full",
      "new": "((.max_capacity // 0) | tonumber) < 0",
      "old": "((.max_capacity // 0) | tonumber) <= 0",
      "target": "script"
    },
    {
      "name": "freshness-check-dropped",
      "new": "fabs) < 300000)",
      "old": "fabs) < 300)",
      "target": "script"
    },
    {
      "name": "required-slots-validation-dropped",
      "new": "^.+$",
      "old": "^[1-9][0-9]*$",
      "target": "script"
    },
    {
      "name": "labels-length-check-dropped",
      "new": "type == \"array\"",
      "old": "type == \"array\" and length > 0",
      "target": "script"
    }
  ]
